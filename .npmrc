# Vercel runs the build with NODE_ENV=production, which makes npm omit
# devDependencies by default. The build (`npm run build` -> `tsc -b`) relies on
# dev-only TypeScript type packages: `@types/node` (used by the `api/` and
# `scripts/` projects), `@types/react`, and `vite/client`. If devDependencies
# are skipped, TypeScript reports TS2591 for `node:http` / `node:crypto` /
# `process`.
#
# `include=dev` forces devDependencies to be installed regardless of NODE_ENV
# or an explicit `--production` / `--omit=dev` flag, so the build is
# reproducible on Vercel and locally.
include=dev
