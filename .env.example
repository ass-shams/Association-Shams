# Client-side (exposed to the browser — safe to commit)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAFRouxxotcfi73Ut

# Server-side only (Vercel serverless functions). NEVER import these client-side.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional: server uses SUPABASE_URL, falling back to VITE_SUPABASE_URL when unset.
SUPABASE_URL=

# Optional Golden Voice overrides (defaults are baked into the code).
# Bucket name defaults to `golden-voice-videos`.
GOLDEN_VOICE_VIDEO_BUCKET=
# Maximum accepted video size in bytes; defaults to 209715200 (200 MB).
GOLDEN_VOICE_MAX_VIDEO_BYTES=

# --- Golden Voice → Google Sheets sync (server only) ---
# Spreadsheet ID from the sheet URL: /spreadsheets/d/<THIS_ID>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=
# Recommended: paste the full contents of the downloaded service-account JSON
# key file. Kept only in the server environment; never commit it.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Alternative to GOOGLE_SERVICE_ACCOUNT_JSON (use one or the other):
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Optional worksheet tab name; defaults to `Sheet1`.
GOOGLE_SHEETS_SHEET_NAME=
# Bearer secret protecting the staff-only endpoints
# (/api/golden-voice/sheets-sync and /api/golden-voice/video-link).
GOLDEN_VOICE_ADMIN_SECRET=
